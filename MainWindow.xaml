<Window x:Class="Vice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Vice"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Icon="Marionette.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="311*"/>
            <RowDefinition Height="109*"/>
        </Grid.RowDefinitions>
        
        <ScrollViewer Margin="5">
            <TextBlock Text="{Binding Output}" TextWrapping="WrapWithOverflow" Background="WhiteSmoke" Padding="5" />
            
        </ScrollViewer>
        
        <Button Width="200" Height="50" Content="Stop" Command="{Binding StopThread}" Grid.Row="1" HorizontalAlignment="Left" Margin="20,0"/>
        <Button Width="200" Height="50" Content="Start" Command="{Binding StartThread}" Grid.Row="1" HorizontalAlignment="Left" Margin="240,0"/>

        <Ellipse Width="30" Height="30" Fill="{Binding ActiveColour}" Grid.Row="1" HorizontalAlignment="Right" Margin="50,0" Stroke="Black"/>

    </Grid>
</Window>
