<Window x:Class="Vice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Vice"
        xmlns:Con="clr-namespace:Vice.Resources"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Icon="Resources\Images\Marionette.ico">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <Grid.Resources>
            <Con:ColourConvert x:Key="Colour"/>
            <Con:InvertBool x:Key="Invert"/>
            <Con:ColourIntConvert x:Key="IntCol"/>
            <Con:ValueMultiply x:Key="Modifier"/>
            <Con:Percentage x:Key="Percentage"/>
            <Con:Offsetter x:Key="Offset"/>            
            <SolidColorBrush x:Key="BaseColour" Color="#FFD4D4D4"/>
            <Style x:Key="Cicle Button" TargetType="Button">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Fill="{TemplateBinding Background}" Stroke="Black" StrokeThickness="1"
                                     x:Name="Ellipse"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Ellipse" Property="Stroke" Value="gray"/>
                                    <Setter TargetName="Ellipse" Property="Fill" Value="white"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="Retangle Button" TargetType="Button">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Opacity="1">
                                <Rectangle Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Fill="{TemplateBinding Background}" Stroke="Black" StrokeThickness="1"
                                     x:Name="Rec" RadiusX="6" RadiusY="6"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding ModeChanging}" Value="True">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Rec" Property="Stroke" Value="gray"/>
                                    <Setter TargetName="Rec" Property="Fill" Value="white"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ModeButton" TargetType="Button">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="Margin" Value="3"/>
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style x:Key="VolumeBar" TargetType="ProgressBar">
                <Setter Property="Width" Value="20"/>
            </Style>
            <Style x:Key="night Button" TargetType="Button">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Opacity="1">
                                <Rectangle Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Fill="{TemplateBinding Background}" Stroke="Black" StrokeThickness="1"
                                     x:Name="Rec" RadiusX="6" RadiusY="6"/>
                                <Label x:Name="Lab" HorizontalAlignment="Center" VerticalAlignment="Center" Content="NightMode - Off"/>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding Data.NightMode}" Value="True">
                                    <Setter Property="Background" Value="#FF404040"/>
                                    <Setter TargetName="Lab" Property="Foreground" Value="White"/>
                                    <Setter TargetName="Lab" Property="Content" Value="NightMode - On"/>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Rec" Property="Stroke" Value="gray"/>
                                    <Setter TargetName="Rec" Property="StrokeThickness" Value="3"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SleepBox" TargetType="TextBox">
                <Setter Property="BorderBrush" Value="DarkGray"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="false"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsFocused" Value="true">
                        <Setter Property="BorderBrush" Value="Black"/>
                    </Trigger>
                    <DataTrigger Binding="{Binding Sleeper.Active}" Value="true">
                        <Setter Property="BorderBrush" Value="Green"/>
                        <Setter Property="BorderThickness" Value="3"/>
                        <Setter Property="IsReadOnly" Value="True"/>
                        <Setter Property="IsManipulationEnabled" Value="False"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SleepButton" TargetType="Button">
                <Setter Property="Content" Value="Start"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Sleeper.Active}" Value="true">
                        <Setter Property="Content" Value="Stop"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Sleeper.Timer}" Value="0">
                        <Setter Property="IsEnabled" Value="False"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Resources>

        <DockPanel>
            <Menu DockPanel.Dock="Top" VerticalAlignment="Center">
                <MenuItem Header="File">
                    <MenuItem Header="Open Log"/>
                    <MenuItem Header="Restart"/>
                </MenuItem>
                <MenuItem Header="Commands">
                    <MenuItem Header="Volume">
                        
                    </MenuItem>
                    <MenuItem Header="Media">
                        
                    </MenuItem>
                    <MenuItem Header="Power">
                        
                    </MenuItem>
                    <MenuItem Header="Remote">
                        
                    </MenuItem>
                    <MenuItem Header="Test Serial" Command="{Binding SendCommand}"/>
                    <MenuItem Header="Test" Command="{Binding TestCommandcom}"/>

                </MenuItem>
                <MenuItem Header="Defaults">
                    <MenuItem Header="Power">
                        <MenuItem Header="TV" Command="{Binding DefaultTVPower}"/>
                        <MenuItem Header="Bar" Command="{Binding DefaultBarPower}"/>
                    </MenuItem>
                    <MenuItem Header="Tv Mode">
                        <MenuItem Header="Normal" Command="{Binding DefaultN}"/>
                        <MenuItem Header="Cinema" Command="{Binding DefaultC}"/>
                        <MenuItem Header="True Cinema" Command="{Binding DefaultTC}"/>
                    </MenuItem>
                    <MenuItem Header="Night Mode" Command="{Binding NightModeSwap}"/>
                    <MenuItem Header="Volume Reset" Command="{Binding VolumeReset}"/>
                </MenuItem>
            </Menu>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer Margin="5" Grid.Row="1">
                <TextBlock Text="{Binding Output}" TextWrapping="WrapWithOverflow" Background="WhiteSmoke" Padding="5"/>
            </ScrollViewer>

            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="3*"/>
                </Grid.RowDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <Label Content="Power" HorizontalAlignment="Center" FontSize="15" Height="24" Padding="2" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="50">
                        <Button Content="TV" Width="50" Height="35" Style="{StaticResource Cicle Button}" Margin="5,0" Background="{Binding Data.TvPower, Converter={StaticResource Colour}}"
                            Command="{Binding PowerTvCommand}"/>
                        <Button Content="Bar" Width="50" Height="35" Style="{StaticResource Cicle Button}" Margin="5,0" Background="{Binding Data.BarPower, Converter={StaticResource Colour}}"
                            Command="{Binding PowerBarCommand}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Center">
                    <StackPanel VerticalAlignment="Center">
                        <Label Content="Tv Mode" HorizontalAlignment="Center" FontSize="15" Height="24" Padding="2" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="50">
                            <Button Content="/\" Width="50" Height="30" Style="{StaticResource Retangle Button}" Margin="5,0" Background="{StaticResource BaseColour}"
                            Command="{Binding TvUp}" FontSize="15" IsEnabled="{Binding ModeChanging, Converter={StaticResource Invert}}"/>
                            <Button Content="\/" Width="50" Height="30" Style="{StaticResource Retangle Button}" Margin="5,0" Background="{StaticResource BaseColour}"
                            Command="{Binding TvDown}" FontSize="15" IsEnabled="{Binding ModeChanging, Converter={StaticResource Invert}}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <Button Content="N" Style="{StaticResource ModeButton}" Background="{Binding Data.TvMode, Converter={StaticResource IntCol}, ConverterParameter=3}"
                                Command="{Binding TvModeN}"/>
                        <Button Content="C" Style="{StaticResource ModeButton}" Background="{Binding Data.TvMode, Converter={StaticResource IntCol}, ConverterParameter=2}"
                                Command="{Binding TvModeC}"/>
                        <Button Content="TC" Style="{StaticResource ModeButton}" Background="{Binding Data.TvMode, Converter={StaticResource IntCol}, ConverterParameter=1}"
                                Command="{Binding TvModeTC}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Name="Stack">
                    <Label Content="Bar Volume" HorizontalAlignment="Center" FontSize="15" Height="24" Padding="2"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                        <ProgressBar Orientation="Vertical" Height="{Binding ElementName=Stack, Path=ActualHeight, Converter={StaticResource Modifier}, ConverterParameter=0.95}"
                                     Style="{StaticResource VolumeBar}" Value="{Binding Data.TvVolume, Converter={StaticResource Percentage}, ConverterParameter=50}" Margin="2,0"/>
                        <Slider Orientation="Vertical" Height="{Binding ElementName=Stack, Path=ActualHeight, Converter={StaticResource Offset}, ConverterParameter=16}"
                                Margin="2,0" Minimum="0" Maximum="50" Value="{Binding TvTargetVolume}" TickPlacement="TopLeft" TickFrequency="5"/>
                        <StackPanel>
                            <Label Content="Current:" Padding="0" HorizontalAlignment="Center"/>
                            <Label Margin="5,0,5,5" BorderBrush="Black" BorderThickness="1" Height="30" Width="50" Content="{Binding Data.TvVolume}" 
                                   HorizontalContentAlignment="Center" FontSize="20" Padding="0"/>
                            <Label Content="Target:" Padding="0" HorizontalAlignment="Center"/>
                            <Label Margin="5,0,5,5" BorderBrush="Black" BorderThickness="1" Height="30" Width="50" Content="{Binding TvTargetVolume}"
                                   HorizontalContentAlignment="Center" FontSize="20" Padding="0"/>
                            <Button Content="+5" Width="40" Height="25" Margin="2" Command="{Binding TvVolUp5}"/>
                            <Button Content="+1" Width="40" Height="25" Margin="2" Command="{Binding TvVolUp1}"/>
                            <Button Content="-1" Width="40" Height="25" Margin="2" Command="{Binding TvVolDown1}"/>
                            <Button Content="-5" Width="40" Height="25" Margin="2" Command="{Binding TvVolDown5}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1">
                    <Label Content="Subwoofer Volume" HorizontalAlignment="Center" FontSize="15" Height="24" Padding="2"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Name="Stack2">
                        <ProgressBar Orientation="Vertical" Height="{Binding ElementName=Stack2, Path=ActualHeight, Converter={StaticResource Modifier}, ConverterParameter=0.95}"
                                     Style="{StaticResource VolumeBar}" Value="{Binding Data.SubVolume, Converter={StaticResource Percentage}, ConverterParameter=12}" Margin="2,0"/>
                        <Slider Orientation="Vertical" Height="{Binding ElementName=Stack2, Path=ActualHeight, Converter={StaticResource Offset}, ConverterParameter=16}"
                                Margin="2,0" Minimum="0" Maximum="12" Value="{Binding SubTargetVolume}" TickPlacement="TopLeft" TickFrequency="2"/>
                        <StackPanel>
                            <Label Content="Current:" Padding="0" HorizontalAlignment="Center"/>
                            <Label Margin="5,0,5,5" BorderBrush="Black" BorderThickness="1" Height="30" Width="50" Content="{Binding Data.SubVolume}" 
                                   HorizontalContentAlignment="Center" FontSize="20" Padding="0"/>
                            <Label Content="Target:" Padding="0" HorizontalAlignment="Center"/>
                            <Label Margin="5,0,5,5" BorderBrush="Black" BorderThickness="1" Height="30" Width="50" Content="{Binding SubTargetVolume}"
                                   HorizontalContentAlignment="Center" FontSize="20" Padding="0"/>
                            <Button Content="+2" Width="40" Height="25" Margin="2" Command="{Binding SubVolUp2}"/>
                            <Button Content="-2" Width="40" Height="25" Margin="2" Command="{Binding SubVolDown2}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Content="NightMode" Margin="0,12" Style="{StaticResource night Button}" Width="140" Height="40" Command="{Binding NightmodeComm}"/>
                </StackPanel>
            </Grid>

            <Border BorderThickness="0,0,2,0" BorderBrush="Black"/>
        </Grid>

        <Border BorderThickness="0,2,0,2" BorderBrush="#FFAAA6A6" Grid.Row="1"/>

        <Button Width="80" Height="40" Content="Stop" Command="{Binding StopThread}" Grid.Row="2" HorizontalAlignment="Left" Margin="20,0"/>
        <Button Width="80" Height="40" Content="Start" Command="{Binding StartThread}" Grid.Row="2" HorizontalAlignment="Left" Margin="120,0,0,0"/>

        <Label Content="Sleep Timer" Grid.Row="2" Margin="320,0,0,0" FontSize="15" Width="90" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <TextBox Width="80" Height="30" Grid.Row="2" Margin="265,20,0,0" HorizontalAlignment="Left" HorizontalContentAlignment="Center" GotKeyboardFocus="SleepText_GotKeyboardFocus"
                 Text="{Binding Sleeper.Timer}" VerticalContentAlignment="Center" FontSize="15" Style="{StaticResource SleepBox}" KeyDown="TextBox_KeyDown" Name="SleepText"
                 LostKeyboardFocus="SleepText_LostKeyboardFocus"/>

        <Button Width="60" Height="30" Grid.Row="2" HorizontalAlignment="Left" Margin="360,20,0,0" Command="{Binding SleepStartStop}" Style="{StaticResource SleepButton}"/>
        <Button Width="40" Height="30" Content="+5" Grid.Row="2" HorizontalAlignment="Left" Margin="430,20,0,0" Command="{Binding SleepFive}"/>

        <Ellipse Width="30" Height="30" Fill="{Binding ActiveColour}" Grid.Row="2" HorizontalAlignment="Right" Margin="50,0" Stroke="Black"/>
        <Ellipse Width="15" Height="15" Fill="{Binding ActiveColourSaver}" Grid.Row="2" HorizontalAlignment="Right" Margin="30,0" Stroke="Black"/>

    </Grid>
</Window>
